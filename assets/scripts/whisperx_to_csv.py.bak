#!/usr/bin/env python3
"""Convert WhisperX JSON output to CSV format expected by aeditor.

Output CSV columns: start,stop,name,tier
- 'words' tier contains word-level alignments
- 'phones' tier marker signals end of word data (for compatibility with textgrid format)
"""

import argparse
import csv
import json
import sys


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("json_file", help="WhisperX JSON output file")
    parser.add_argument("-o", "--output", required=True, help="Output CSV file")
    args = parser.parse_args()

    try:
        with open(args.json_file) as f:
            data = json.load(f)
    except (FileNotFoundError, json.JSONDecodeError) as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)

    words = []
    for segment in data.get("segments", []):
        for word in segment.get("words", []):
            if "start" in word and "end" in word:
                words.append({
                    "start": word["start"],
                    "stop": word["end"],
                    "name": word["word"].strip(),
                    "tier": "words",
                })

    with open(args.output, "w", newline="") as f:
        writer = csv.writer(f)
        writer.writerow(["start", "stop", "name", "tier"])
        for w in words:
            writer.writerow([w["start"], w["stop"], w["name"], w["tier"]])
        writer.writerow(["0", "0", "", "phones"])


if __name__ == "__main__":
    main()
